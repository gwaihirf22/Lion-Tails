# Copy to .env for local development. Never commit the real .env.

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Public base URL. Used in verification / password-reset email links, so it
# must match how users actually reach the app.
FRONTEND_URL=http://localhost:5000

# --- Database ------------------------------------------------------------
# Standard Postgres connection string. Leave unset to run against in-memory
# storage (data is lost on restart).
DATABASE_URL=postgresql://liontails:liontails@localhost:5432/liontails

# --- Secrets -------------------------------------------------------------
# Both are REQUIRED when NODE_ENV=production; the app refuses to start without
# them. Generate with: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=

# --- OpenAI --------------------------------------------------------------
# Used for story generation (gpt-4o) and illustrations (dall-e-3).
# Users may also supply their own key in app settings.
OPENAI_API_KEY=

# --- Email (optional) ----------------------------------------------------
# Only used when NODE_ENV=production, for account verification and password
# resets. Leave blank to disable those emails.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Lion Tails <no-reply@paul-blake.com>
