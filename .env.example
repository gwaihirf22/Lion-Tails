# Copy to .env for local development. Never commit the real .env.

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Stamped on each generation record so a story can be traced to the build
# that wrote it. The Docker build sets it to the commit SHA; blank is fine.
APP_VERSION=

# --- Database ------------------------------------------------------------
# Standard Postgres connection string. Leave unset to run against in-memory
# storage (data is lost on restart).
DATABASE_URL=postgresql://liontails:liontails@localhost:5432/liontails

# --- Secrets -------------------------------------------------------------
# REQUIRED when NODE_ENV=production; the app refuses to start without it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- OpenAI --------------------------------------------------------------
# The owner's key: pays for the economy tier (gpt-5.6-luna) and for pictures
# on the free allowance. Users may also supply their own key in app settings,
# which unlocks the premium tier for them. Never give any OTHER setting an
# OPENAI_* name -- the SDK reads several of those from the environment and
# sends them (see CLAUDE.md, "Model selection").
OPENAI_API_KEY=

# --- Local model provider (optional) ---
# Self-hosted Ollama, used for the free "local" model tier. Container name
# rather than an IP: the container's address is not stable across recreates.
OLLAMA_BASE_URL=http://ollama:11434/v1

# Total context window of the local model, shared between prompt AND output.
# The retry escalation clamps to this: doubling the output budget past what the
# prompt leaves free achieves nothing. Must match Ollama's OLLAMA_CONTEXT_LENGTH.
MODEL_CONTEXT_LIMIT=16384

# How a character's attributes and skills are written into the brief: "table"
# (default) or "prose". An experiment switch; see storyBrief.ts.
CHARACTER_STATS_STYLE=table

# --- Password-reset email (SMTP) --------------------------------------------
# The one email this app sends. Production uses a dedicated Gmail account:
# 2-step verification on, one APP PASSWORD generated for this app, and the
# domain address verified under Gmail's "Send mail as" so the From line
# reads as the app. Then SMTP_HOST=smtp.gmail.com, SMTP_USER=the Gmail
# address, SMTP_PASSWORD=the app password, MAIL_FROM=the alias.
#
# THE APP PASSWORD IS A CREDENTIAL: it is full access to that mailbox.
# SMTP_PASSWORD_FILE pointing at a root-only file is the other accepted form,
# as COSTS_ADMIN_KEY_FILE is. Press "Send a test email" on /admin/accounts
# once it is set, so a wrong password is found that day.
#
# ALL BLANK: in production, reset requests answer 503 ("not available just
# now") rather than a 200 that promises an email nobody can send. On a dev
# box the token comes back in the response and the link is logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
MAIL_FROM=

# --- What things cost (optional, admin only) -------------------------------
# The bill check on /admin/costs compares the app's own ledger with OpenAI's
# real bill. It needs an ORGANISATION ADMIN key (not the API key above): as a
# root-only file mounted read-only, or the value itself. Read on every use,
# never returned by a route. Deliberately not named OPENAI_ADMIN_KEY: the SDK
# would pick that up and send it. See CLAUDE.md, "What things cost".
COSTS_ADMIN_KEY_FILE=
COSTS_ADMIN_KEY=
# The OpenAI project the app's key belongs to (proj_...). Without it the
# check compares the whole organisation, which also holds other projects.
COSTS_PROJECT_ID=

# --- The signup challenge (Cloudflare Turnstile) -------------------------
# What stops a script minting accounts: every new account carries free credits
# that spend the owner's OpenAI key, so registration is worth guarding.
#
# Make a widget at https://dash.cloudflare.com/?to=/:account/turnstile and add
# the site's hostname (plus 127.0.0.1 and 192.168.1.9 if you want it on a dev
# box). The SITE key is public -- it is served to the browser. The SECRET is
# not: TURNSTILE_SECRET, or TURNSTILE_SECRET_FILE pointing at a root-only file,
# as COSTS_ADMIN_KEY_FILE does.
#
# LEAVE BOTH BLANK IN DEVELOPMENT and there is no challenge at all, which is
# what lets scripts/dev-seed.ts and scripts/capture-guide.ts register accounts.
# IN PRODUCTION A MISSING SECRET REFUSES SIGN-UPS rather than reopening the
# hole -- server/lib/turnstile.ts explains why.
#
# Cloudflare's documented test keys, for a dev box or a browser test:
#   always passes:  site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
#   always blocks:  site 2x00000000000000000000AB  secret 2x0000000000000000000000000000000AA
#   forces a click: site 3x00000000000000000000FF
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_SECRET_FILE=

# --- Account alerts (Telegram) -------------------------------------------
#
# Where the accounts watch sends what it finds. Blake already runs Telegram
# for Sonarr and the server's notifications, and the only email this app
# sends is a parent's reset link (above), so this is the channel that exists.
#
# BOTH BLANK IS OFF, and /admin/accounts says so plainly rather than showing
# a button that quietly does nothing. The findings are on that page either
# way: nothing here is alert-only.
#
# To set it up: message @BotFather on Telegram, /newbot, and keep the token
# it gives you. Then send your new bot a message, open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read `chat.id` out of
# the reply -- that is TELEGRAM_CHAT_ID. Then press "Send a test message" on
# /admin/accounts, which is there so this is proven the day it is set rather
# than the night it was supposed to say something.
#
# THE TOKEN IS A CREDENTIAL: anyone holding it can send and read as the bot.
# TELEGRAM_BOT_TOKEN_FILE pointing at a root-only file is the other accepted
# form, as COSTS_ADMIN_KEY_FILE is. The chat id is not a secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_CHAT_ID=

# Only used to put a link at the bottom of an alert. Optional, not a secret.
PUBLIC_URL=
